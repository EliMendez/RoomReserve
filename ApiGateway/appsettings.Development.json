{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ReverseProxy": {
    "Routes": {
      "rooms-route": {
        "ClusterId": "room-service",
        "Match": {
          "Path": "/api/rooms/{**catch-all}"
        }
      },
      "bookings-route": {
        "ClusterId": "booking-service",
        "Match": {
          "Path": "/api/bookings/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "room-service": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5273/"
          }
        }
      },
      "booking-service": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5180/"
          }
        }
      }
    }
  }
}
